# Copy to .env. Names only; never commit real values.
ENGINE_HOST=localhost
ENGINE_PORT=8765
# Scenario under assets/scenarios/ the engine loads at startup.
SCENARIO=paradise
# Read by Vite; set if the engine runs elsewhere.
VITE_ENGINE_URL=ws://localhost:8765
# Scenario terrain the UI shows (a folder in assets/scenarios). ?scenario= overrides it.
VITE_SCENARIO=paradise
