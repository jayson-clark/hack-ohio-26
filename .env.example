# Copy to .env. Names only; never commit real values.
ENGINE_HOST=localhost
ENGINE_PORT=8765
# Browser origins the engine accepts, comma-separated (default: Vite on :1420 and the Tauri app).
# ENGINE_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost
# Scenario under assets/scenarios/ the engine loads at startup.
SCENARIO=paradise
# Read by Vite; set if the engine runs elsewhere.
VITE_ENGINE_URL=ws://localhost:8765
# Scenario terrain the UI shows (a folder in assets/scenarios). ?scenario= overrides it.
VITE_SCENARIO=paradise
# Webcam for vision: a camera index (0, 1, ...) or a video/image path (relative to the repo root).
# Leave empty for virtual table only. `cd engine && uv run python -m vision.camera 0` checks an index.
CAMERA=
# Agent board (tools/agent_board). Point BOARD_URL at whoever runs `make board`, e.g. http://jaysons-mac.local:8790.
BOARD_URL=http://localhost:8790
# Set on the machine running the board to share it on the LAN.
# BOARD_HOST=0.0.0.0
# Optional shared secret for posting; everyone sets the same value.
# BOARD_TOKEN=
# Who you are on the board (defaults to your gh login).
# BOARD_USER=
