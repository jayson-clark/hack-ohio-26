# Copy to .env. Names only; never commit real values.
ENGINE_HOST=localhost
ENGINE_PORT=8765
# Browser origins the engine accepts, comma-separated (default: Vite on :1420 and the Tauri app).
# ENGINE_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost
# Scenario under assets/scenarios/ the engine loads at startup.
SCENARIO=paradise
# Read by Vite; set if the engine runs elsewhere.
VITE_ENGINE_URL=ws://localhost:8765
# Scenario terrain the UI shows (a folder in assets/scenarios). ?scenario= overrides it.
VITE_SCENARIO=paradise
# Webcam for vision: a camera index (0, 1, ...) or a video/image path (relative to the repo root).
# Leave empty for virtual table only. `cd engine && uv run python -m vision.camera 0` checks an index.
CAMERA=
# Projector lens position, in mm: east, north from the terrain's south-west corner, then up
# from the table (e.g. 297,187,572). Calibration solves it from the dot grid; this is only the
# starting guess and the fallback if the dots aren't seen. Optional.
PROJECTOR_MM=
# Optional engine extras for `make engine`, space-separated: "ml" (the learned fire
# emulator: instant forecast previews and crew-spot screening, Apple silicon) and
# "voice" (push-to-talk). Empty means Monte Carlo only and no push-to-talk.
ENGINE_EXTRAS=
# Agent board (tools/agent_board). The team board is the default; use http://localhost:8790 for a local `make board`.
BOARD_URL=https://hack.apps.jaysonc.dev
# Shared secret for posting to the team board. Ask Jayson for it.
BOARD_TOKEN=
# Who you are on the board (defaults to your gh login).
# BOARD_USER=
# Incident commander (engine/commander/agent.py). Without a key it answers from templates.
ANTHROPIC_API_KEY=
# Model for the commander's answers. Haiku keeps it to about a tenth of a cent per question.
COMMANDER_MODEL=claude-haiku-5-5
