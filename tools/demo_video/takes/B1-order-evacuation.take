# Order Pulga's evacuation from the decision queue; the queue re-sorts and
# Paradise, hours overdue, rises to the top.
engine fresh 0.25 paused

prep
  reload
  waitfor "Fit the whole map" timeout=15
  click "Fit the whole map"
  move 700,500

scene "Order Pulga's evacuation from the queue"
  hold 1.5
  key period
  waitfor "Order evacuation" timeout=20
  hold 2.5                      # read the card
  click "Order evacuation" role=button index=0
  hold 2.5                      # the queue re-sorts
  move 188,968                  # the "Pulga is evacuating" card
  hold 3

# Close on the queue's first card to read it, then pan down to Pulga evacuating.
zoom 1@1..1@end-4 depth=5 at=0.19,0.36
zoom 1@end-4..end depth=4 at=0.29,0.74
label "0.25× · 2.5 sim-min/s" 1@1.5..end
export B1-order-evacuation.mp4
