# Read a crew recommendation, dispatch it, watch the unit drive in.
engine fresh 0.25 paused

prep
  reload
  waitfor "Fit the whole map" timeout=15
  click "Fit the whole map"
  move 700,500

scene "The queue fills; read a crew recommendation"
  hold 1
  key period
  waitfor "Send a crew" timeout=20
  hold 1.5
  click "Send a crew" index=0
  hold 5.5

scene "Dispatch the crew and speed up to watch it drive in"
  click "Dispatch" role=button index=0   # the inspector's button
  hold 2
  key ]
  key ]                                  # 0.25x -> 1x
  move 1150,600
  hold 8

# The inspector's recommendation, then pan to the map for the drive-in.
zoom 1@end-5.5..2@2 depth=4 at=0.71,0.30
zoom 2@2..end depth=3 at=0.62,0.50
label "0.25× · 2.5 sim-min/s" 1@1..2@2
label "1× · 10 sim-min/s" 2@2..end
export B2-dispatch-crew.mp4
