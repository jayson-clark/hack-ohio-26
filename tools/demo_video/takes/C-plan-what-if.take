# Plan mode: assume the wind swings east (kept at 8 m/s, under ember
# spotting's 9 m/s, so lines and crews can hold), add the recommended
# crews and a dozer line, read the outcome against doing nothing, dispatch.
# The slider and map points are window points for the 1668x1084 window.
engine fresh 0.5 paused
engine advance 90

prep
  reload
  waitfor "Fit the whole map" timeout=15
  click "Fit the whole map"
  move 1100,700

scene "Plan mode: assume the wind swings east"
  hold 1.5
  click "Plan" role=button
  hold 1.5
  click "What if…"
  hold 0.6
  drag 75,514 114,514 ms=900    # wind direction thumb: NE 45 -> E 90
  hold 2

scene "Add the recommended crews and a dozer line"
  click "Add recommended"
  hold 1.5
  click "Dozer line" role=button
  click 1191,470                # west of the fire's tip, between crews 1 and 2
  key escape
  move 1300,900
  waitfor "Saves" timeout=30
  hold 4
  move 180,790
  hold 4.5

scene "Dispatch the plan"
  click "Dispatch" role=button index=0
  hold 4

# Sliders and the 2 h outcome; pan to the map as crews, the line and the
# green "saved" shading land; pan back to read the numbers; out to dispatch.
zoom 1@3..2@0.5 depth=5 at=0.19,0.45
zoom 2@0.5..2@end-4.5 depth=4 at=0.71,0.42
zoom 2@end-4.5..3@0.5 depth=4 at=0.29,0.62
label "Paused · planning" 1@0..end
export C-plan-what-if.mp4
