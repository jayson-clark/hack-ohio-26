# Plan mode: assume the wind swings east and picks up, add the recommended
# crews and a dozer line, read the outcome against doing nothing, dispatch.
# The slider and map points are window points for the 1668x1084 window.
engine fresh 0.5 paused
engine advance 90

prep
  reload
  waitfor "Fit the whole map" timeout=15
  click "Fit the whole map"
  move 1100,700

scene "Plan mode: assume the wind swings east and picks up"
  hold 1
  click "Plan" role=button
  hold 1.5
  click "What if…"
  hold 0.6
  click 75,514                  # wind direction slider
  key right x9                  # NE 45 -> E 90
  hold 0.7
  click 159,465                 # wind speed slider
  key right x4                  # 8 -> 12 m/s
  hold 1.2

scene "Add the recommended crews and a dozer line"
  click "Add recommended"
  hold 1.5
  click "Dozer line" role=button
  click 1198,514                # between the fire and Concow
  key escape
  move 1300,900
  waitfor "Saves" timeout=30
  hold 4
  move 180,790
  hold 4

scene "Dispatch the plan"
  click "Dispatch" role=button index=0
  hold 4

zoom 1@3..2@0 depth=3 at=0.17,0.50
zoom 2@end-8..2@end at=0.30,0.70
label "Paused · planning" 1@0..end
export C-plan-what-if.mp4
