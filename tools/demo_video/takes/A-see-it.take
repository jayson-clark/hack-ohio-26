# The fire spreads from Pulga with its forecast bands, then Paradise's
# evacuation clock: the order is already overdue a minute in.
# Zoom focus is a fraction of the window (see the README's "Aiming zooms").
engine fresh 0.5 paused

prep
  reload                        # clears selection, zoom, plan, dock and autopilot
  waitfor "Fit the whole map" timeout=15
  click "Fit the whole map"
  move 1150,560

scene "Fire spreads from Pulga with forecast bands at 0.5x"
  hold 2.5                      # wide: the whole console, to get bearings
  key period                    # resume
  move 1200,560 ms=1500
  hold 11
  move 900,640
  hold 1.5

scene "Open Paradise: the evacuation clock"
  click "Paradise" index=1      # the map label (0 is the header)
  hold 2.5
  move 1488,712                 # rest on Order evacuation, off the numbers
  hold 6

# The fire, Pulga, Concow and Magalia; then pan to Paradise's inspector.
zoom 1@3..2@0.8 depth=4 at=0.71,0.40
zoom 2@0.8..end depth=4 at=0.71,0.42
label "0.5× · 5 sim-min/s" 1@2.5..end
export A-see-it.mp4
