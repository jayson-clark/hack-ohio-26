# The fire spreads from Pulga with its forecast bands, then Paradise's
# evacuation clock: the order is already overdue a minute in.
# Zoom focus is a fraction of the window (see the README's "Aiming zooms").
engine fresh 0.5 paused

prep
  reload                        # clears selection, zoom, plan, dock and autopilot
  waitfor "Fit the whole map" timeout=15
  click "Fit the whole map"
  move 860,1000                 # parked below the fire, off everything

scene "Fire spreads from Pulga with forecast bands at 0.5x"
  hold 2.5                      # wide: the whole console, to get bearings
  key period                    # resume
  move 900,700 ms=1500          # between Paradise and the fire
  hold 12.5

scene "Open Paradise: the evacuation clock"
  click "Paradise" index=1      # the map label (0 is the header)
  hold 0.4
  # Selecting a town zooms the map to its evacuation zone, which for Paradise
  # is all the map shows. Refit so the fire coming at it is in frame.
  click "Fit the whole map"
  move 780,750                  # rest between Paradise and the fire, off the numbers
  hold 7

# The fire and every town in its way, Paradise included; then a small pan up
# so Paradise's whole inspector (header to Order evacuation) is in frame
# beside the fire. Depth 4 can't fit the inspector: it's 0.59 of the
# window's height and reaches its right edge.
zoom 1@3..2@1 depth=3 at=0.64,0.47
zoom 2@1..end depth=3 at=0.64,0.38
label "0.5× · 5 sim-min/s" 1@2.5..end
export A-see-it.mp4
